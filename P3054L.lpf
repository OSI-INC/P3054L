IOBUF PORT "xdac[4]" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
IOBUF PORT "RCK" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
FREQUENCY NET "RCK_c" 0.032000 MHz ;
BLOCK RD_DURING_WR_PATHS ;
BLOCK INTERCLOCKDOMAIN PATHS ;
BLOCK JITTER ;
