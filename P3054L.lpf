BLOCK RESETPATHS ;
BLOCK ASYNCPATHS ;
SYSCONFIG MUX_CONFIGURATION_PORTS=ENABLE JTAG_PORT=DISABLE ;
IOBUF PORT "SCK" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
